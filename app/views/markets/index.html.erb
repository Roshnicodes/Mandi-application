<% content_for :title, "Mandi Master" %>

<section class="responsive-stack">
  <% content_for :page_heading do %>
    <div>
      <p class="eyebrow">Master Setup</p>
      <h1>Mandi / APMC master</h1>
    </div>
  <% end %>

  <% content_for :page_actions do %>
    <%= link_to "District Master", districts_path, class: "button button-secondary" %>
    <%= link_to "Add Mandi", new_market_path, class: "button button-primary" %>
  <% end %>
  <div class="table-card">
    <% if @markets.any? %>
      <div class="data-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Mandi</th>
              <th>District</th>
              <th>State</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @markets.each do |market| %>
              <tr>
                <td><strong><%= mandi_display_name(market.name) %></strong></td>
                <td><%= market.district.name %></td>
                <td><%= market.district.state.name %></td>
                <td>
                  <div class="inline-actions">
                    <%= link_to "Edit", edit_market_path(market), class: "button button-secondary" %>
                    <%= button_to "Delete", market_path(market), method: :delete, class: "button button-danger", form: { data: { turbo_confirm: "Delete this market?" }, class: "button-to-inline" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">No mandi records yet.</div>
    <% end %>
  </div>
</section>
