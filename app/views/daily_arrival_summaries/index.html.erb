<% content_for :title, "Arrival Summary" %>

<section class="responsive-stack arrival-summary-page">
  <% content_for :page_heading do %>
    <div>
      <p class="eyebrow">Arrival intelligence</p>
      <h1>Daily arrival summary</h1>
    </div>
  <% end %>

  <% content_for :page_actions do %>
    <%= link_to "Open daily reports", daily_price_arrival_reports_path, class: "button button-ghost" %>
    <%= link_to "Download Excel", export_daily_price_arrival_reports_path(request.query_parameters.slice("state_id", "from_date", "to_date")), class: "button button-primary" %>
  <% end %>
  <div class="card arrival-summary-filter-card">
    <div class="card-header">
      <div>
        <h2 class="table-title">Reporting window</h2>
        <p class="table-subtitle">Choose a state and date range; every card below updates together.</p>
      </div>
    </div>

    <%= form_with url: daily_arrival_summaries_path, method: :get, class: "filters-form filters-form-compact" do |form| %>
      <div class="form-grid-three">
        <div class="field-group">
          <%= form.label :state_id, "State" %>
          <%= form.collection_select :state_id, @states, :id, :name, { include_blank: "All states", selected: params[:state_id] } %>
        </div>
        <div class="field-group">
          <%= form.label :from_date, "From date" %>
          <%= form.date_field :from_date, value: params[:from_date] %>
        </div>
        <div class="field-group">
          <%= form.label :to_date, "To date" %>
          <%= form.date_field :to_date, value: params[:to_date] %>
        </div>
      </div>
      <div class="inline-actions">
        <%= form.submit "Update summary", class: "button button-primary" %>
        <%= link_to "Reset", daily_arrival_summaries_path, class: "button button-ghost" %>
      </div>
    <% end %>
  </div>

  <div class="summary-report-card arrival-summary-title-card">
    <p class="eyebrow">Current report</p>
    <h2 class="summary-report-title"><%= @report_title %></h2>
  </div>

  <div class="metrics-grid">
    <div class="stat-card">
      <span class="stat-label">Districts covered</span>
      <strong><%= number_with_delimiter(@grouped_reports.size) %></strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Report rows</span>
      <strong><%= number_with_delimiter(@reports.size) %></strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Total arrival</span>
      <strong><%= number_with_precision(@total_arrival_quantity, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></strong>
    </div>
  </div>

  <% if @grouped_reports.any? %>
    <div class="arrival-summary-district-list">
      <% @grouped_reports.each do |district, reports| %>
        <% district_total = reports.sum(&:arrival_quantity) %>
        <% district_markets = reports.map(&:market_id).uniq.size %>
        <article class="table-card report-sheet-card arrival-summary-district-card">
          <header class="arrival-summary-district-header">
            <div>
              <p class="eyebrow">District</p>
              <h2 class="table-title"><%= district.name %></h2>
              <p class="table-subtitle"><%= number_with_delimiter(district_markets) %> mandis · <%= number_with_delimiter(reports.size) %> saved rows</p>
            </div>
            <div class="arrival-summary-total">
              <span>Arrival total</span>
              <strong><%= number_with_precision(district_total, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></strong>
            </div>
          </header>

          <div class="data-table-wrapper">
            <table class="report-grid-table arrival-summary-table">
              <thead>
                <tr>
                  <th>Mandi</th>
                  <th>Commodity</th>
                  <th>Variety / Grade</th>
                  <th>Min</th>
                  <th>Max</th>
                  <th>Modal</th>
                  <th>Arrival</th>
                  <th>Report date</th>
                  <th>Reference</th>
                </tr>
              </thead>
              <tbody>
                <% reports.sort_by { |report| [report.market.name.downcase, -report.arrival_date.jd, -report.created_at.to_i] }.each do |report| %>
                  <% price_unit = report.price_unit.short_name.presence || report.price_unit.name %>
                  <% arrival_unit = report.arrival_unit.short_name.presence || report.arrival_unit.name %>
                  <tr>
                    <td><strong><%= mandi_display_name(report.market.name) %></strong></td>
                    <td>
                      <strong><%= report.commodity.name %></strong>
                      <span class="arrival-summary-cell-detail"><%= report.commodity_group.name %></span>
                    </td>
                    <td>
                      <strong><%= report.variety.name %></strong>
                      <span class="arrival-summary-cell-detail"><%= report.grade.name %></span>
                    </td>
                    <td class="numeric-cell"><%= number_with_precision(report.min_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %><small><%= price_unit %></small></td>
                    <td class="numeric-cell"><%= number_with_precision(report.max_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %><small><%= price_unit %></small></td>
                    <td class="numeric-cell arrival-summary-modal"><%= number_with_precision(report.modal_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %><small><%= price_unit %></small></td>
                    <td class="numeric-cell"><%= number_with_precision(report.arrival_quantity, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %><small><%= arrival_unit %></small></td>
                    <td><%= report.arrival_date.strftime("%d %b %Y") %></td>
                    <td class="arrival-summary-reference"><%= report.remarks.presence || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">No summary data found for the selected filters.</div>
  <% end %>
</section>
