<% content_for :title, "Daily Price Arrival Reports" %>

<section class="responsive-stack">
  <div class="page-header">
    <div>
      <p class="eyebrow">Report Entry</p>
      <h1>Daily price arrival reports</h1>
    </div>
    <div class="page-actions">
      <%= link_to "Add Daily Report", new_daily_price_arrival_report_path, class: "button button-primary" %>
      <% if admin_user? %>
        <%= link_to "View Excel", export_daily_price_arrival_reports_path(request.query_parameters.merge(preview: true)), class: "button button-secondary", target: "_blank", rel: "noopener" %>
        <%= link_to "Download Excel", export_daily_price_arrival_reports_path(request.query_parameters), class: "button button-secondary" %>
        <%= form_with url: import_daily_price_arrival_reports_path, multipart: true, class: "import-inline-form" do %>
          <%= file_field_tag :excel_file, accept: ".xls,.xlsx,.html,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", required: true %>
          <%= submit_tag "Import Excel", class: "button button-secondary" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card report-filter-card">
    <div class="card-header">
      <div>
        <h2 class="table-title">Filter reports</h2>
      </div>
      <div class="report-filter-stats">
        <span><strong><%= number_with_delimiter(@filtered_count) %></strong> reports</span>
        <span><strong><%= number_with_precision(@filtered_arrival_total, precision: 2, strip_insignificant_zeros: true) %></strong> arrival</span>
      </div>
    </div>

    <%= form_with url: daily_price_arrival_reports_path, method: :get, class: "filters-form filters-form-compact" do |form| %>
      <div class="form-grid-three">
        <div class="field-group">
          <%= form.label :state_id, "State" %>
          <%= form.collection_select :state_id, @states, :id, :name, { include_blank: "All states", selected: params[:state_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :district_id, "District" %>
          <%= form.collection_select :district_id, @districts, :id, :name, { include_blank: "All districts", selected: params[:district_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :market_id, "Mandi" %>
          <%= form.collection_select :market_id, @markets, :id, :name, { include_blank: "All mandis", selected: params[:market_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :commodity_group_id, "Commodity group" %>
          <%= form.collection_select :commodity_group_id, @commodity_groups, :id, :name, { include_blank: "All groups", selected: params[:commodity_group_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :commodity_id, "Commodity" %>
          <%= form.collection_select :commodity_id, @commodities, :id, :name, { include_blank: "All commodities", selected: params[:commodity_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :variety_id, "Variety" %>
          <%= form.collection_select :variety_id, @varieties, :id, :name, { include_blank: "All varieties", selected: params[:variety_id] } %>
        </div>

        <div class="field-group">
          <%= form.label :from_date, "From date" %>
          <%= form.date_field :from_date, value: params[:from_date] %>
        </div>

        <div class="field-group">
          <%= form.label :to_date, "To date" %>
          <%= form.date_field :to_date, value: params[:to_date] %>
        </div>
      </div>

      <div class="inline-actions">
        <%= form.submit "Apply filters", class: "button button-primary" %>
        <%= link_to "Reset", daily_price_arrival_reports_path, class: "button button-ghost" %>
      </div>
    <% end %>
  </div>

  <div class="table-card">
    <div class="table-card-header">
      <div>
        <h2 class="table-title">Saved reports</h2>
      </div>
    </div>
    <% if @reports.any? %>
      <div class="data-table-wrapper">
        <table data-unit-table>
          <thead>
            <tr>
              <th>Created On</th>
              <th>Arrival Date</th>
              <th>Mandi</th>
              <th>Commodity</th>
              <th>Variety</th>
              <th>Grade</th>
              <th>Min</th>
              <th>Max</th>
              <th>
                <span class="unit-heading">
                  Modal
                  <select class="unit-select" data-unit-control="price" aria-label="Modal price unit">
                    <option value="qtl">Qtl</option>
                    <option value="kg">Kg</option>
                    <option value="mt">MT</option>
                  </select>
                </span>
              </th>
              <th>
                <span class="unit-heading">
                  Arrival Qty
                  <select class="unit-select" data-unit-control="arrival" aria-label="Arrival quantity unit">
                    <option value="qtl">Qtl</option>
                    <option value="kg">Kg</option>
                    <option value="mt">MT</option>
                  </select>
                </span>
              </th>
              <th>Attachments</th>
              <% if admin_user? %>
                <th>Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr>
                <td><%= report.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
                <td><%= report.arrival_date.strftime("%d %b %Y") %></td>
                <td>
                  <%= report.market.name %>
                  <span class="sheet-inline-hint"><%= [report.state.name, report.district.name].join(" / ") %></span>
                </td>
                <td><%= report.commodity.name %></td>
                <td><%= report.variety.name %></td>
                <td><%= report.grade.name %></td>
                <td class="numeric-cell"><%= number_with_precision(report.min_price, precision: 2) %></td>
                <td class="numeric-cell"><%= number_with_precision(report.max_price, precision: 2) %></td>
                <td class="numeric-cell" data-unit-value data-unit-kind="price" data-source-value="<%= report.modal_price %>" data-source-unit="<%= report.price_unit.short_name.presence || report.price_unit.name %>"><%= number_with_precision(report.modal_price, precision: 2) %></td>
                <td class="numeric-cell" data-unit-value data-unit-kind="arrival" data-source-value="<%= report.arrival_quantity %>" data-source-unit="<%= report.arrival_unit.short_name.presence || report.arrival_unit.name %>"><%= number_with_precision(report.arrival_quantity, precision: 2) %></td>
                <td>
                  <%= render "shared/attachment_links", record: report %>
                </td>
                <% if admin_user? %>
                  <td>
                    <div class="inline-actions">
                      <%= link_to "Edit", edit_daily_price_arrival_report_path(report), class: "button button-secondary" %>
                      <%= button_to "Delete", daily_price_arrival_report_path(report), method: :delete, class: "button button-danger", form: { class: "button-to-inline" } %>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">Selected filters ke liye koi daily report nahi mila.</div>
    <% end %>
  </div>
</section>
