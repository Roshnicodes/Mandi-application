<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>APMC Daily Mandi Sheet</title>
  <style>
    body { font-family: Calibri, Arial, sans-serif; color: #17251c; margin: 0; padding: 22px; background: #f3f7f2; }
    .preview-toolbar { display: flex; gap: 10px; align-items: center; justify-content: flex-end; margin-bottom: 18px; position: sticky; top: 0; z-index: 2; background: #f3f7f2; padding: 8px 0; }
    .preview-button { display: inline-block; padding: 10px 14px; border-radius: 9px; background: #ffffff; color: #1f5535; text-decoration: none; font-weight: 700; border: 1px solid #c8d8cc; }
    .preview-button.primary { background: #22673f; color: #ffffff; border-color: #22673f; }
    .report-section { max-width: 940px; margin: 0 auto 28px; page-break-after: always; background: #ffffff; border: 1px solid #cbd7ce; box-shadow: 0 8px 24px rgba(24, 53, 34, 0.08); }
    .report-section:last-child { page-break-after: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 14px; }
    th, td { border: 1px solid #2e3a31; padding: 7px 8px; vertical-align: middle; mso-number-format: "\\@"; }
    .report-title { padding: 11px; font-size: 18px; line-height: 1.35; font-weight: 700; text-align: center; background: #f8ead9; color: #24342a; }
    .column-heading { min-height: 58px; font-size: 13px; line-height: 1.25; font-weight: 700; text-align: center; background: #fbfcfa; }
    .market-cell { width: 23%; font-weight: 700; }
    .arrival-cell { width: 14%; text-align: right; }
    .price-cell { width: 16%; text-align: right; }
    .reference-cell { width: 15%; color: #47584d; }
    .report-row:nth-child(even) td { background: #fbfdfb; }
    .sheet-meta { display: flex; justify-content: space-between; gap: 12px; padding: 9px 12px; border-bottom: 1px solid #dce4de; color: #597062; font-size: 12px; }
    .empty { max-width: 700px; margin: 40px auto; padding: 28px; border: 1px dashed #9fb1a5; color: #53685a; text-align: center; background: #ffffff; }
    @media print {
      body { padding: 0; background: #ffffff; }
      .preview-toolbar { display: none; }
      .report-section { max-width: none; margin-bottom: 0; border: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <% if params[:preview].present? %>
    <div class="preview-toolbar">
      <a href="#" onclick="window.close(); return false;" class="preview-button">Close</a>
      <a href="#" onclick="window.print(); return false;" class="preview-button">Print</a>
      <%= link_to "Download Excel", export_daily_price_arrival_reports_path(request.query_parameters.except(:preview)), class: "preview-button primary" %>
    </div>
  <% end %>

  <% if @reports.any? %>
    <% report_sections = @reports.to_a.group_by { |report| [report.commodity_id, report.state_id, report.arrival_date] } %>
    <% report_sections.sort_by { |(_ids, reports)| [-reports.first.arrival_date.jd, reports.first.commodity.name.downcase, reports.first.state.name.downcase] }.each do |_ids, section_reports| %>
      <% first_report = section_reports.first %>
      <% report_date = first_report.arrival_date %>
      <% commodity_name = first_report.commodity.name %>
      <% state_label = first_report.state.code.presence || first_report.state.name %>
      <% arrival_units = section_reports.map { |report| report.arrival_unit.short_name.presence || report.arrival_unit.name }.uniq %>
      <% price_units = section_reports.map { |report| report.price_unit.short_name.presence || report.price_unit.name }.uniq %>
      <% arrival_unit_label = arrival_units.one? ? arrival_units.first : "Reported unit" %>
      <% price_unit_label = price_units.one? ? price_units.first : "Reported unit" %>

      <section class="report-section">
        <div class="sheet-meta">
          <span>APMC Daily Mandi Sheet</span>
          <span><%= section_reports.size %> report<%= "s" unless section_reports.one? %></span>
        </div>
        <table>
          <thead>
            <tr>
              <th colspan="6" class="report-title"><%= commodity_name %> Commodity Arrival and Rates - <%= "#{report_date.day.ordinalize} #{report_date.strftime('%b, %Y')}" %> State - <%= state_label %></th>
            </tr>
            <tr>
              <th class="column-heading">APMC</th>
              <th class="column-heading">Arrivals<br>(In <%= arrival_unit_label %>)</th>
              <th class="column-heading">Minimum Price<br>(<%= price_unit_label %>)</th>
              <th class="column-heading">Maximum Price<br>(<%= price_unit_label %>)</th>
              <th class="column-heading">Modal Price<br>(<%= price_unit_label %>)</th>
              <th class="column-heading">Reference</th>
            </tr>
          </thead>
          <tbody>
            <% section_reports.sort_by { |report| [report.market.name.downcase, report.variety.name.downcase, report.grade.name.downcase, report.created_at] }.each do |report| %>
              <tr class="report-row">
                <td class="market-cell"><%= mandi_display_name(report.market.name) %></td>
                <td class="arrival-cell"><%= number_with_precision(report.arrival_quantity, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></td>
                <td class="price-cell"><%= number_with_precision(report.min_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></td>
                <td class="price-cell"><%= number_with_precision(report.max_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></td>
                <td class="price-cell"><%= number_with_precision(report.modal_price, precision: 2, strip_insignificant_zeros: true, delimiter: ",") %></td>
                <td class="reference-cell"><%= report.remarks.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  <% else %>
    <div class="empty">No reports found for the selected filters.</div>
  <% end %>
</body>
</html>
