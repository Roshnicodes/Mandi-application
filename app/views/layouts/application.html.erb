<!DOCTYPE html>
<html>
  <head>
    <title><%= app_title(content_for(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="IMAN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="<%= authenticated? ? "app-shell-body" : "auth-shell-body" %><%= " dashboard-unified-page" if content_for?(:dashboard_unified) %>">
    <% if authenticated? %>
      <div class="app-shell">
        <aside class="sidebar" id="app-sidebar" data-app-sidebar>
          <div class="sidebar-mobile-header">
            <span class="sidebar-mobile-brand">IMAN</span>
            <button type="button" class="sidebar-close-button" data-sidebar-close aria-label="Close navigation">
              <span></span>
              <span></span>
            </button>
          </div>

          <div class="brand-card">
            <div class="brand-top">
              <div class="brand-mark">IM</div>
            </div>

            <div class="brand-copy">
              <h1>IMAN</h1>
            </div>
          </div>

          <nav class="nav-stack">
            <div class="nav-group">
              <p class="nav-label">Workspace</p>
              <% primary_navigation.each do |item| %>
                <%= link_to item[:path], class: ["nav-link", item[:active] ? "active" : nil] do %>
                  <%= icon(item[:icon], class_name: "nav-link-icon") %>
                  <span><%= item[:label] %></span>
                <% end %>
              <% end %>
            </div>

            <% if master_navigation.any? %>
              <div class="nav-group">
                <p class="nav-label">Masters</p>
                <% master_navigation.each do |item| %>
                  <%= link_to item[:path], class: ["nav-link", item[:active] ? "active" : nil] do %>
                    <%= icon(item[:icon], class_name: "nav-link-icon") %>
                    <span><%= item[:label] %></span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </nav>
        </aside>

        <button type="button" class="sidebar-overlay" data-sidebar-overlay aria-hidden="true" tabindex="-1"></button>

        <main class="app-main">
          <%# One card carries the page heading, the page's own actions and the
              account controls, instead of a thin bar stacked over a title card. %>
          <header class="app-topbar<%= " app-topbar-integrated" if content_for?(:dashboard_unified) %>">
            <button
              type="button"
              class="mobile-nav-button"
              data-sidebar-toggle
              aria-expanded="false"
              aria-controls="app-sidebar"
            >
              <span></span>
              <span></span>
              <span></span>
              <em>Menu</em>
            </button>
            <button
              type="button"
              class="desktop-sidebar-toggle"
              data-sidebar-toggle
              aria-expanded="true"
              aria-controls="app-sidebar"
              title="Toggle menu"
              aria-label="Toggle menu"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>

            <div class="app-topbar-heading">
              <% if content_for?(:page_heading) %>
                <%= yield :page_heading %>
              <% else %>
                <h1><%= content_for?(:title) ? yield(:title) : "IMAN" %></h1>
              <% end %>
            </div>

            <% if content_for?(:page_actions) %>
              <div class="app-topbar-trail">
                <div class="page-actions"><%= yield :page_actions %></div>
              </div>
            <% end %>

            <div class="app-topbar-account">
              <div class="user-pill">
                <span class="user-pill-name"><%= current_user.name %></span>
                <span class="user-pill-meta"><%= Date.current.strftime("%d %b %Y") %></span>
              </div>
              <%= button_to "Logout", session_path, method: :delete, class: "button button-ghost" %>
            </div>
          </header>

          <div class="page-frame">
            <%= render "shared/flash" %>
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <div class="auth-shell">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    <% end %>

    <%= render "shared/mandi_ui_script" %>
  </body>
</html>
