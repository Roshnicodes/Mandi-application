<!DOCTYPE html>
<html>
  <head>
    <title><%= app_title(content_for(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="IMAN">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body
    class="<%= authenticated? ? "app-shell-body" : "auth-shell-body" %><%= " dashboard-unified-page" if content_for?(:dashboard_unified) %>"
    <% if authenticated? %>style="--mandi-market-image: url('<%= asset_path("login_gallery/mandi-grains.png") %>'); --mandi-hero-image: url('<%= asset_path("mandi-hero-banner.webp") %>');"<% end %>
  >
    <% if authenticated? %>
      <%# Apply the saved collapsed-menu choice before first paint so the page doesn't jump. %>
      <script>
        try {
          if (window.innerWidth > 980 && window.localStorage.getItem("iman-sidebar-collapsed") === "true") {
            document.body.classList.add("sidebar-collapsed");
          }
        } catch (_error) {}
      </script>
      <div class="app-shell">
        <aside class="sidebar" id="app-sidebar" data-app-sidebar>
          <div class="sidebar-mobile-header">
            <span class="sidebar-mobile-brand">IMAN</span>
            <button type="button" class="sidebar-close-button" data-sidebar-close aria-label="Close navigation">
              <span></span>
              <span></span>
            </button>
          </div>

          <div class="brand-card">
            <div class="brand-top">
              <div class="brand-mark"><%= icon("leaf", size: 25) %></div>
            </div>

            <div class="brand-copy">
              <strong class="brand-name">IMAN</strong>
              <p class="brand-copy-text">Mandi Information &amp; Analytics Network</p>
            </div>
          </div>

          <nav class="nav-stack">
            <div class="nav-group">
              <p class="nav-label">Workspace</p>
              <% primary_navigation.each do |item| %>
                <%= link_to item[:path], class: ["nav-link", item[:active] ? "active" : nil], title: item[:label], aria: { current: (item[:active] ? "page" : nil) } do %>
                  <span class="nav-icon tone-<%= item[:tone] %>"><%= icon(item[:icon], size: 16, class_name: "nav-link-icon") %></span>
                  <span class="nav-text"><%= item[:label] %></span>
                <% end %>
              <% end %>
            </div>

            <% if master_navigation.any? %>
              <div class="nav-group">
                <p class="nav-label">Masters</p>
                <% master_navigation.each do |item| %>
                  <%= link_to item[:path], class: ["nav-link", item[:active] ? "active" : nil], title: item[:label], aria: { current: (item[:active] ? "page" : nil) } do %>
                    <span class="nav-icon tone-<%= item[:tone] %>"><%= icon(item[:icon], size: 16, class_name: "nav-link-icon") %></span>
                    <span class="nav-text"><%= item[:label] %></span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </nav>

          <div class="sidebar-footer">
            <span class="sidebar-footer-mark"><%= icon("leaf", size: 17) %></span>
            <span><strong>Better markets</strong><small>Brighter farmers</small></span>
          </div>
        </aside>

        <button type="button" class="sidebar-overlay" data-sidebar-overlay aria-hidden="true" tabindex="-1"></button>

        <main class="app-main">
          <header class="app-topbar">
            <button
              type="button"
              class="mobile-nav-button"
              data-sidebar-toggle
              aria-expanded="false"
              aria-controls="app-sidebar"
            >
              <span></span>
              <span></span>
              <span></span>
              <em>Menu</em>
            </button>
            <button
              type="button"
              class="desktop-sidebar-toggle"
              data-sidebar-toggle
              aria-expanded="true"
              aria-controls="app-sidebar"
              title="Show / hide menu"
              aria-label="Show or hide menu"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>

            <%= form_with url: daily_price_arrival_reports_path, method: :get, class: "app-global-search", role: "search" do %>
              <%= icon("search", size: 16) %>
              <%= text_field_tag :q, nil, placeholder: "Search mandi, district, commodity…", aria: { label: "Search mandi reports" } %>
            <% end %>

            <div class="app-topbar-account">
              <div class="user-pill">
                <span class="user-avatar" aria-hidden="true"><%= current_user.name.to_s.first.upcase %></span>
                <span>
                  <span class="user-pill-name"><%= current_user.name %></span>
                  <span class="user-pill-meta"><%= Date.current.strftime("%d %b %Y") %></span>
                </span>
              </div>
              <%= button_to session_path, method: :delete, class: "button button-ghost app-logout", title: "Logout", aria: { label: "Logout" } do %>
                <%= icon("logout", size: 16) %><span>Logout</span>
              <% end %>
            </div>
          </header>

          <div class="page-frame">
            <%= render "shared/flash" %>

            <%# Page banner: the screen's heading and actions over a mandi photo. %>
            <% nav_item = current_navigation_item %>
            <section class="page-hero">
              <span class="page-hero-icon tone-<%= nav_item&.dig(:tone) || "green" %>"><%= icon(nav_item&.dig(:icon) || "leaf", size: 24) %></span>
              <div class="page-hero-heading">
                <% if content_for?(:page_heading) %>
                  <%= yield :page_heading %>
                <% else %>
                  <h1><%= content_for?(:title) ? yield(:title) : "IMAN" %></h1>
                <% end %>
              </div>
              <span class="page-hero-art" aria-hidden="true"></span>
              <div class="page-hero-side">
                <% if content_for?(:page_actions) %>
                  <div class="page-actions"><%= yield :page_actions %></div>
                <% end %>
                <% unless content_for?(:dashboard_unified) %>
                  <div class="page-hero-date">
                    <%= icon("calendar", size: 18) %>
                    <span><strong><%= Date.current.strftime("%d %b %Y") %></strong><small>Today</small></span>
                  </div>
                <% end %>
              </div>
            </section>

            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <div class="auth-shell">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    <% end %>

    <%= render "shared/mandi_ui_script" %>
  </body>
</html>
