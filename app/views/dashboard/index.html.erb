<% content_for :title, "Dashboard" %>
<% content_for :dashboard_unified, true %>

<% content_for :topbar_tools do %>
  <div class="dashboard-card-actions">
    <%= link_to "Add Daily Report", new_daily_price_arrival_report_path, class: "portal-primary-action" %>
    <%= link_to "View all reports", daily_price_arrival_reports_path, class: "portal-secondary-action" %>
  </div>
<% end %>

<section class="portal-dashboard portal-dashboard-integrated">
  <div class="dashboard-overview-grid">
    <article class="dashboard-overview-card dashboard-overview-card-strong">
      <span>Latest report date</span>
      <strong><%= @latest_arrival_date.present? ? @latest_arrival_date.strftime("%d %b %Y") : "No data" %></strong>
      <p>Latest mandi snapshot</p>
    </article>
    <article class="dashboard-overview-card">
      <span>Total reports</span>
      <strong><%= number_with_delimiter(@total_reports) %></strong>
      <p>Saved entries</p>
    </article>
    <article class="dashboard-overview-card">
      <span>Today entries</span>
      <strong><%= number_with_delimiter(@today_reports) %></strong>
      <p><%= Date.current.strftime("%d %b %Y") %></p>
    </article>
    <article class="dashboard-overview-card">
      <span>Covered mandis</span>
      <strong><%= number_with_delimiter(@covered_mandis) %></strong>
      <p>Active coverage</p>
    </article>
    <article class="dashboard-overview-card dashboard-clock-card">
      <div class="dashboard-clock-face" aria-hidden="true">
        <span class="dashboard-clock-hand dashboard-clock-hour"></span>
        <span class="dashboard-clock-hand dashboard-clock-minute"></span>
        <span class="dashboard-clock-dot"></span>
      </div>
      <div>
        <span>Live time</span>
        <strong><%= @dashboard_time.strftime("%I:%M %p") %></strong>
        <p><%= @dashboard_time.strftime("%d %b %Y") %></p>
      </div>
    </article>
  </div>

  <% if @recent_reports.any? %>
    <div class="dashboard-latest-panel">
      <div class="dashboard-latest-header">
        <div>
          <p class="eyebrow">Latest Reports</p>
          <h2>Recent mandi activity</h2>
        </div>
        <div class="dashboard-latest-meta">
          <span><%= @recent_reports.size %> latest</span>
          <strong><%= number_with_precision(@latest_arrival_total, precision: 2, strip_insignificant_zeros: true) %> latest qty</strong>
        </div>
      </div>

      <div class="portal-table-scroll">
        <table class="portal-report-table dashboard-report-table" data-unit-table>
          <thead>
            <tr>
              <th>Arrival Date</th>
              <th>Mandi</th>
              <th>Commodity</th>
              <th>Variety</th>
              <th>Grade</th>
              <th>
                <span class="unit-heading">
                  Modal
                  <select class="unit-select" data-unit-control="price" aria-label="Modal price unit">
                    <option value="qtl">Qtl</option>
                    <option value="kg">Kg</option>
                    <option value="mt">MT</option>
                  </select>
                </span>
              </th>
              <th>
                <span class="unit-heading">
                  Arrival
                  <select class="unit-select" data-unit-control="arrival" aria-label="Arrival quantity unit">
                    <option value="qtl">Qtl</option>
                    <option value="kg">Kg</option>
                    <option value="mt">MT</option>
                  </select>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @recent_reports.each do |report| %>
              <tr>
                <td><strong><%= report.arrival_date.strftime("%d/%m/%Y") %></strong></td>
                <td>
                  <%= report.market.name %>
                  <span class="sheet-inline-hint"><%= [report.state.name, report.district.name].join(" / ") %></span>
                </td>
                <td><%= report.commodity.name %></td>
                <td><%= report.variety.name %></td>
                <td><%= report.grade.name %></td>
                <td class="numeric-cell" data-unit-value data-unit-kind="price" data-source-value="<%= report.modal_price %>" data-source-unit="<%= report.price_unit.short_name.presence || report.price_unit.name %>"><%= number_with_precision(report.modal_price, precision: 2, delimiter: ",") %></td>
                <td class="numeric-cell" data-unit-value data-unit-kind="arrival" data-source-value="<%= report.arrival_quantity %>" data-source-unit="<%= report.arrival_unit.short_name.presence || report.arrival_unit.name %>"><%= number_with_precision(report.arrival_quantity, precision: 2, delimiter: ",") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="portal-table-footer">
        <span>Showing <strong>1</strong> to <strong><%= @recent_reports.size %></strong> of <strong><%= number_with_delimiter(@total_reports) %></strong> entries</span>
        <%= link_to "View all reports", daily_price_arrival_reports_path %>
      </div>
    </div>
  <% else %>
    <div class="portal-empty-state">
      No daily reports yet.
      <%= link_to "Add Daily Report", new_daily_price_arrival_report_path, class: "portal-primary-action dashboard-empty-action" %>
    </div>
  <% end %>
</section>
