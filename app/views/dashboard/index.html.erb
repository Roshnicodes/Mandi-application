<% content_for :title, "Dashboard" %>

<%
  top_state_count = @state_summaries.values.max.to_i
  top_state_count = 1 if top_state_count.zero?
%>

<section class="portal-dashboard">
  <nav class="portal-breadcrumb" aria-label="Breadcrumb">
    <%= link_to "Home", root_path %>
    <span>›</span>
    <strong>Dashboard</strong>
    <span class="portal-required-note">Data updated from saved mandi reports</span>
  </nav>

  <div class="portal-module-panel">
    <div class="portal-panel-title">
      <div>
        <span class="portal-title-kicker">Mandi Reporting Workspace</span>
        <h1>Dashboard</h1>
      </div>
      <span class="portal-help" title="Dashboard Help">?</span>
    </div>

    <div class="portal-module-tabs">
      <%= link_to "Dashboard", root_path, class: "active" %>
      <%= link_to "Daily Reports", daily_price_arrival_reports_path %>
      <%= link_to "Arrival Summary", daily_arrival_summaries_path %>
      <%= link_to "Cotton Bulletins", cotton_bulletins_path %>
      <%= link_to "Cotton Overview", cotton_market_overviews_path %>
      <%= link_to "Market / APMC", markets_path %>
      <%= link_to "Commodity Master", commodities_path %>
      <%= link_to "State Master", states_path %>
    </div>
  </div>

  <div class="portal-summary-grid">
    <article>
      <span>Latest Reporting Date</span>
      <strong><%= @latest_report_date&.strftime("%d/%m/%Y") || "No data" %></strong>
    </article>
    <article>
      <span>Total Daily Reports</span>
      <strong><%= number_with_delimiter(@total_reports) %></strong>
    </article>
    <article>
      <span>Markets Covered</span>
      <strong><%= number_with_delimiter(@markets_covered) %></strong>
    </article>
    <article>
      <span>Commodities Covered</span>
      <strong><%= number_with_delimiter(@commodities_covered) %></strong>
    </article>
    <article>
      <span>Latest Arrival Quantity</span>
      <strong><%= number_with_precision(@today_arrival_quantity, precision: 2, delimiter: ",") %></strong>
    </article>
  </div>

  <div class="portal-work-grid">
    <section class="portal-table-panel">
      <div class="portal-section-heading">
        <span class="portal-collapse-mark">−</span>
        <div>
          <h2>Latest Daily Reports</h2>
          <p>Recently entered market arrival and commodity price records</p>
        </div>
        <%= link_to "Add Daily Report", new_daily_price_arrival_report_path, class: "portal-primary-action" %>
      </div>

      <div class="portal-report-tabs">
        <%= link_to daily_price_arrival_reports_path do %>
          Latest <strong><%= @recent_reports.size %></strong>
        <% end %>
        <%= link_to daily_price_arrival_reports_path, class: "completed" do %>
          All Reports <strong><%= @total_reports %></strong>
        <% end %>
      </div>

      <% if @recent_reports.any? %>
        <div class="portal-table-scroll">
          <table class="portal-report-table">
            <thead>
              <tr>
                <th>Arrival Date</th>
                <th>Market / APMC</th>
                <th>State</th>
                <th>Commodity</th>
                <th>Variety</th>
                <th>Modal Price</th>
                <th>Arrival Qty.</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_reports.each do |report| %>
                <tr>
                  <td><strong><%= report.arrival_date.strftime("%d/%m/%Y") %></strong></td>
                  <td><%= report.market.name %></td>
                  <td><%= report.state.name %></td>
                  <td><%= report.commodity.name %></td>
                  <td><%= report.grade.name %></td>
                  <td class="numeric-cell"><%= number_with_precision(report.modal_price, precision: 2, delimiter: ",") %><br><small><%= report.price_unit.short_name.presence || report.price_unit.name %></small></td>
                  <td class="numeric-cell"><%= number_with_precision(report.arrival_quantity, precision: 2, delimiter: ",") %><br><small><%= report.arrival_unit.short_name.presence || report.arrival_unit.name %></small></td>
                  <td><span class="portal-status">UPDATED</span></td>
                  <td>
                    <%= link_to "Edit", edit_daily_price_arrival_report_path(report), class: "portal-row-action" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="portal-table-footer">
          <span>Showing <strong>1</strong> to <strong><%= @recent_reports.size %></strong> of <strong><%= @total_reports %></strong> entries</span>
          <%= link_to "View all reports ›", daily_price_arrival_reports_path %>
        </div>
      <% else %>
        <div class="portal-empty-state">Daily report abhi add nahi hua hai. Pehla market update create karke dashboard ko live data se fill kariye.</div>
      <% end %>
    </section>

    <aside class="portal-side-column">
      <section class="portal-side-card">
        <div class="portal-side-title">
          <span class="portal-collapse-mark">−</span>
          <h2>State Coverage</h2>
        </div>
        <% if @state_summaries.any? %>
          <div class="portal-state-list">
            <% @state_summaries.each do |state_name, count| %>
              <div class="portal-state-row">
                <div><span><%= state_name %></span><strong><%= count %></strong></div>
                <div class="portal-progress"><span style="width: <%= ((count.to_f / top_state_count) * 100).round(1) %>%"></span></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="portal-empty-state compact">Reports save hone ke baad state coverage dikhega.</div>
        <% end %>
      </section>

      <section class="portal-side-card">
        <div class="portal-side-title">
          <span class="portal-collapse-mark">−</span>
          <h2>Quick Tasks</h2>
        </div>
        <div class="portal-task-list">
          <%= link_to new_daily_price_arrival_report_path do %><span>+</span> Add Daily Report<% end %>
          <%= link_to daily_price_arrival_reports_path do %><span>▣</span> Excel Tools<% end %>
          <%= link_to daily_arrival_summaries_path do %><span>≡</span> Arrival Summary<% end %>
          <%= link_to cotton_bulletins_path do %><span>◉</span> Cotton Bulletin<% end %>
          <%= link_to markets_path do %><span>⌂</span> Manage Markets<% end %>
        </div>
      </section>
    </aside>
  </div>

  <footer class="portal-footer">
    <span>Screen Reader</span>
    <span>Website Policies</span>
    <span>Help</span>
    <span>Mandi Information Portal</span>
    <strong>Copyright © <%= Date.current.year %></strong>
  </footer>
</section>
