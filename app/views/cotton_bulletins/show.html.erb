<% content_for :title, @cotton_bulletin.title %>

<section class="responsive-stack">
  <% content_for :page_heading do %>
    <div class="page-header-copy">
      <p class="eyebrow">Cotton Sheet Builder</p>
      <h1><%= @cotton_bulletin.title %></h1>
      <p class="muted-text">
        Report date: <strong><%= @cotton_bulletin.report_date.strftime("%d %b %Y") %></strong>
        <% if @cotton_bulletin.notes.present? %>
          · <%= @cotton_bulletin.notes %>
        <% end %>
      </p>
    </div>
  <% end %>

  <% content_for :page_actions do %>
    <%= link_to export_cotton_bulletin_path(@cotton_bulletin), class: "button button-primary" do %>
      <%= icon("download", size: 16) %> Excel
    <% end %>
    <% if admin_user? %>
      <%= link_to export_cotton_bulletin_path(@cotton_bulletin, preview: true), class: "button button-soft", target: "_blank", rel: "noopener" do %>
        <%= icon("eye", size: 16) %> View
      <% end %>
      <%= form_with url: import_cotton_bulletin_path(@cotton_bulletin), multipart: true, class: "import-inline-form" do %>
        <%= file_field_tag :excel_file, accept: ".xls,.xlsx,.html,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", required: true %>
        <%= submit_tag "Import", class: "button button-soft" %>
      <% end %>
      <%= link_to edit_cotton_bulletin_path(@cotton_bulletin), class: "button button-soft" do %>
        <%= icon("pencil", size: 16) %> Edit
      <% end %>
    <% end %>
    <%= link_to cotton_bulletins_path, class: "button button-outline" do %>
      <%= icon("chevron-left", size: 16) %> Back
    <% end %>
  <% end %>
  <%# Search and the row counts share one line: the sheet is already rendered,
      so the search filters the sections below in place. %>
  <div class="filter-bar sheet-search-bar">
    <span class="filter-bar-search">
      <%= icon("search", size: 16) %>
      <%= search_field_tag :sheet_search, nil, placeholder: "Search mandi, gin, parameter or remark…", data: { sheet_search: true }, autocomplete: "off", aria: { label: "Search rows in this report" } %>
    </span>
    <span class="sheet-search-status" data-sheet-search-status aria-live="polite"></span>

    <span class="sheet-count-group">
      <span class="header-stat">
        <strong><%= @cotton_bulletin.cotton_market_observations.count %></strong>
        <small>observation rows</small>
      </span>
      <span class="header-stat">
        <strong><%= @cotton_bulletin.cotton_seed_rates.count + @cotton_bulletin.candy_rates.count %></strong>
        <small>candy + seed</small>
      </span>
      <span class="header-stat">
        <strong><%= @cotton_bulletin.cotton_regional_comparisons.count + @cotton_bulletin.cotton_call_performances.count %></strong>
        <small>comparison</small>
      </span>
    </span>
  </div>

  <%# The mandi table carries the most columns, so it gets a full-width row of its own. %>
  <div class="report-sheet-grid">
    <%= render "observation_section", bulletin: @cotton_bulletin, records: @mandi_observations, category: "mandi_wise", title: "Raw Cotton Rate - Mandi Wise" %>
  </div>

  <div class="report-sheet-grid report-sheet-grid-two">
    <%= render "observation_section", bulletin: @cotton_bulletin, records: @gin_observations, category: "gin_wise", title: "Raw Cotton Rate - Gin Wise" %>
    <%= render "observation_section", bulletin: @cotton_bulletin, records: @cci_observations, category: "cci_mandi", title: "CCI Mandi Rates" %>
  </div>

  <div class="report-sheet-grid report-sheet-grid-two">
    <%= render "observation_section", bulletin: @cotton_bulletin, records: @tdn_observations, category: "tdn_moisture", title: "TDN / Moisture Rates" %>
    <div class="table-card report-sheet-card comparison-launch-card" id="observation-section-comparison_sheet" data-sheet-section>
      <div class="sheet-header">
        <div>
          <p class="eyebrow">Excel Section</p>
          <h2 class="table-title">Comparison Sheet (In Qtl)</h2>
        </div>
        <div class="inline-actions">
          <%= link_to "Open Comparison Sheet", comparison_sheet_cotton_bulletin_path(@cotton_bulletin), class: "button button-primary" %>
        </div>
      </div>
      <div class="comparison-launch-summary">
        <span>Rows saved</span>
        <strong><%= @comparison_observations.size %></strong>
      </div>
    </div>
  </div>

  <div class="report-sheet-grid">
    <%= render "seed_rate_section", bulletin: @cotton_bulletin, records: @seed_rates %>
  </div>

  <div class="report-sheet-grid report-sheet-grid-two">
    <%= render "candy_rate_section", bulletin: @cotton_bulletin, records: @mch_rates, category: "mch", title: "Candy Rate (MCH)" %>
    <%= render "candy_rate_section", bulletin: @cotton_bulletin, records: @dch_rates, category: "dch", title: "Candy Rate (DCH)" %>
  </div>

  <div class="report-sheet-grid report-sheet-grid-two">
    <%= render "regional_comparison_section", bulletin: @cotton_bulletin, records: @regional_comparisons %>
    <%= render "call_performance_section", bulletin: @cotton_bulletin, records: @call_performances %>
  </div>
</section>
