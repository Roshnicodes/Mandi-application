<script>
  const parsePayload = (element, key) => {
    const raw = element?.dataset?.[key];
    if (!raw) return [];

    try {
      return JSON.parse(raw);
    } catch (_error) {
      return [];
    }
  };

  const renderSelectOptions = (select, items, placeholder, selectedValue = null) => {
    if (!select) return;

    const currentValue = selectedValue ?? (select.value || select.dataset.selected);
    select.innerHTML = "";

    const placeholderOption = document.createElement("option");
    placeholderOption.value = "";
    placeholderOption.textContent = placeholder;
    select.appendChild(placeholderOption);

    items.forEach((item) => {
      const option = document.createElement("option");
      option.value = item.id;
      option.textContent = item.label || item.name;
      option.selected = String(item.id) === String(currentValue);
      select.appendChild(option);
    });

    delete select.dataset.selected;
  };

  const setupMarketForm = () => {
    document.querySelectorAll("[data-market-form]").forEach((root) => {
      const stateSelect = root.querySelector("[data-state-select]");
      const districtSelect = root.querySelector("[data-district-select]");
      const districts = parsePayload(root, "districts");

      const refreshDistricts = () => {
        const selectedStateId = stateSelect?.value;
        const filteredDistricts = selectedStateId ? districts.filter((district) => String(district.state_id) === String(selectedStateId)) : districts;
        renderSelectOptions(districtSelect, filteredDistricts, "Select district");
      };

      stateSelect?.addEventListener("change", refreshDistricts);
      refreshDistricts();
    });
  };

  const setupGradeForm = () => {
    document.querySelectorAll("[data-grade-form]").forEach((root) => {
      const commoditySelect = root.querySelector("[data-commodity-select]");
      const varietySelect = root.querySelector("[data-variety-select]");
      const varieties = parsePayload(root, "varieties");

      const refreshVarieties = () => {
        const selectedCommodityId = commoditySelect?.value;
        const filteredVarieties = selectedCommodityId ? varieties.filter((variety) => String(variety.commodity_id) === String(selectedCommodityId)) : varieties;
        renderSelectOptions(varietySelect, filteredVarieties, "Optional variety");
      };

      commoditySelect?.addEventListener("change", refreshVarieties);
      refreshVarieties();
    });
  };

  const setupReportForm = () => {
    document.querySelectorAll("[data-report-form]").forEach((root) => {
      const stateSelect = root.querySelector("[data-state-select]");
      const districtSelect = root.querySelector("[data-district-select]");
      const marketSelect = root.querySelector("[data-market-select]");
      const groupSelect = root.querySelector("[data-commodity-group-select]");
      const commoditySelect = root.querySelector("[data-commodity-select]");
      const varietySelect = root.querySelector("[data-variety-select]");
      const gradeSelect = root.querySelector("[data-grade-select]");

      const districts = parsePayload(root, "districts");
      const markets = parsePayload(root, "markets");
      const commodities = parsePayload(root, "commodities");
      const varieties = parsePayload(root, "varieties");
      const grades = parsePayload(root, "grades");

      const refreshDistricts = () => {
        const selectedStateId = stateSelect?.value;
        const filteredDistricts = selectedStateId ? districts.filter((district) => String(district.state_id) === String(selectedStateId)) : districts;
        renderSelectOptions(districtSelect, filteredDistricts, "Select district");
        refreshMarkets();
      };

      const refreshMarkets = () => {
        const selectedStateId = stateSelect?.value;
        const selectedDistrictId = districtSelect?.value;
        const filteredMarkets =
          selectedDistrictId ? markets.filter((market) => String(market.district_id) === String(selectedDistrictId)) :
          selectedStateId ? markets.filter((market) => String(market.state_id) === String(selectedStateId)) :
          markets;
        renderSelectOptions(marketSelect, filteredMarkets, "Select mandi");
      };

      const syncLocationFromMarket = () => {
        const selectedMarket = markets.find((market) => String(market.id) === String(marketSelect?.value));
        if (!selectedMarket) return;

        if (stateSelect && String(stateSelect.value) !== String(selectedMarket.state_id)) {
          stateSelect.value = selectedMarket.state_id;
          renderSelectOptions(
            districtSelect,
            districts.filter((district) => String(district.state_id) === String(selectedMarket.state_id)),
            "Select district",
            selectedMarket.district_id
          );
        }

        if (districtSelect) districtSelect.value = selectedMarket.district_id;
      };

      const refreshCommodities = () => {
        const selectedGroupId = groupSelect?.value;
        const filteredCommodities = selectedGroupId ? commodities.filter((commodity) => String(commodity.commodity_group_id) === String(selectedGroupId)) : commodities;
        renderSelectOptions(commoditySelect, filteredCommodities, "Select commodity");
        refreshVarieties();
      };

      const refreshVarieties = () => {
        const selectedCommodityId = commoditySelect?.value;
        const filteredVarieties = selectedCommodityId ? varieties.filter((variety) => String(variety.commodity_id) === String(selectedCommodityId)) : varieties;
        renderSelectOptions(varietySelect, filteredVarieties, "Select variety");
        refreshGrades();
      };

      const refreshGrades = () => {
        const selectedCommodityId = commoditySelect?.value;
        const selectedVarietyId = varietySelect?.value;
        const filteredGrades = grades.filter((grade) => {
          const commodityMatches = selectedCommodityId ? String(grade.commodity_id) === String(selectedCommodityId) : true;
          const varietyMatches = !grade.variety_id || !selectedVarietyId || String(grade.variety_id) === String(selectedVarietyId);
          return commodityMatches && varietyMatches;
        });
        renderSelectOptions(gradeSelect, filteredGrades, "Select grade");
      };

      stateSelect?.addEventListener("change", refreshDistricts);
      districtSelect?.addEventListener("change", refreshMarkets);
      marketSelect?.addEventListener("change", syncLocationFromMarket);
      groupSelect?.addEventListener("change", refreshCommodities);
      commoditySelect?.addEventListener("change", refreshVarieties);
      varietySelect?.addEventListener("change", refreshGrades);

      refreshDistricts();
      refreshCommodities();
    });
  };

  const setupDeleteConfirm = () => {
    document.querySelectorAll("form.button-to-inline").forEach((form) => {
      if (form.dataset.confirmBound === "true") return;

      form.dataset.confirmBound = "true";
      form.addEventListener("submit", (event) => {
        if (!window.confirm("Are you sure you want to delete this record?")) {
          event.preventDefault();
        }
      });
    });
  };

  const setupObservationGrid = () => {
    const resetGridInputs = (row) => {
      if (!row || row.dataset.resetOnOpen !== "true") return;

      row.querySelectorAll("input[type='number']").forEach((input) => {
        input.value = "";
      });

      row.querySelectorAll("input[type='file']").forEach((input) => {
        input.value = "";
      });
    };

    document.querySelectorAll("[data-grid-scope] [data-grid-row].is-open").forEach((row) => {
      resetGridInputs(row);
      row.hidden = false;
    });

    document.querySelectorAll("[data-grid-toggle]").forEach((button) => {
      if (button.dataset.gridBound === "true") return;

      button.dataset.gridBound = "true";
      button.addEventListener("click", () => {
        const targetId = button.dataset.gridToggle;
        const targetRow = document.getElementById(targetId);
        const scope = button.closest("[data-grid-scope]") || targetRow?.closest("[data-grid-scope]");
        if (!targetRow || !scope) return;

        const willOpen = targetRow.hidden;

        scope.querySelectorAll("[data-grid-row]").forEach((row) => {
          row.hidden = true;
          row.classList.remove("is-open");
        });

        scope.querySelectorAll("[data-grid-toggle]").forEach((toggle) => {
          toggle.setAttribute("aria-expanded", "false");
        });

        if (willOpen) {
          targetRow.hidden = false;
          targetRow.classList.add("is-open");
          resetGridInputs(targetRow);
          button.setAttribute("aria-expanded", "true");
        }
      });
    });
  };

  const setupDailyEntryDateSync = () => {
    document.querySelectorAll("[data-daily-entry-date]").forEach((dateInput) => {
      if (dateInput.dataset.dateSyncBound === "true") return;

      dateInput.dataset.dateSyncBound = "true";
      const syncDate = () => {
        document.querySelectorAll("[data-daily-entry-date-target]").forEach((target) => {
          target.value = dateInput.value;
        });
      };

      dateInput.addEventListener("change", syncDate);
      syncDate();
    });
  };

  const setupDailyEntryDefaults = () => {
    document.querySelectorAll("[data-daily-entry-defaults]").forEach((root) => {
      if (root.dataset.defaultsBound === "true") return;

      root.dataset.defaultsBound = "true";
      const groupSelect = root.querySelector("[data-daily-default-group]");
      const commoditySelect = root.querySelector("[data-daily-default-commodity]");
      const varietySelect = root.querySelector("[data-daily-default-variety]");
      const gradeSelect = root.querySelector("[data-daily-default-grade]");
      const priceUnitSelect = root.querySelector("[data-daily-default-price-unit]");
      const arrivalUnitSelect = root.querySelector("[data-daily-default-arrival-unit]");

      const commodities = parsePayload(root, "commodities");
      const varieties = parsePayload(root, "varieties");
      const grades = parsePayload(root, "grades");

      const syncTargets = () => {
        const values = {
          commodity_group_id: groupSelect?.value || "",
          commodity_id: commoditySelect?.value || "",
          variety_id: varietySelect?.value || "",
          grade_id: gradeSelect?.value || "",
          price_unit_id: priceUnitSelect?.value || "",
          arrival_unit_id: arrivalUnitSelect?.value || ""
        };

        document.querySelectorAll("[data-daily-default-target]").forEach((target) => {
          target.value = values[target.dataset.dailyDefaultTarget] || "";
        });
      };

      const syncRowGradeSelects = () => {
        document.querySelectorAll("[data-daily-row-grade-select]").forEach((select) => {
          const selectedValue = select.value || select.dataset.selected || gradeSelect?.value;
          select.innerHTML = gradeSelect?.innerHTML || "";
          select.value = selectedValue;
          if (!select.value && gradeSelect?.value) select.value = gradeSelect.value;
          delete select.dataset.selected;
        });
      };

      const refreshGradesForDefaults = () => {
        const selectedCommodityId = commoditySelect?.value;
        const selectedVarietyId = varietySelect?.value;
        const filteredGrades = grades.filter((grade) => {
          const commodityMatches = selectedCommodityId ? String(grade.commodity_id) === String(selectedCommodityId) : true;
          const varietyMatches = !grade.variety_id || !selectedVarietyId || String(grade.variety_id) === String(selectedVarietyId);
          return commodityMatches && varietyMatches;
        });

        renderSelectOptions(gradeSelect, filteredGrades, "Select grade");
        syncRowGradeSelects();
        syncTargets();
      };

      const refreshVarietiesForDefaults = () => {
        const selectedCommodityId = commoditySelect?.value;
        const filteredVarieties = selectedCommodityId ? varieties.filter((variety) => String(variety.commodity_id) === String(selectedCommodityId)) : varieties;
        renderSelectOptions(varietySelect, filteredVarieties, "Select variety");
        refreshGradesForDefaults();
      };

      const refreshCommoditiesForDefaults = () => {
        const selectedGroupId = groupSelect?.value;
        const filteredCommodities = selectedGroupId ? commodities.filter((commodity) => String(commodity.commodity_group_id) === String(selectedGroupId)) : commodities;
        renderSelectOptions(commoditySelect, filteredCommodities, "Select commodity");
        refreshVarietiesForDefaults();
      };

      groupSelect?.addEventListener("change", refreshCommoditiesForDefaults);
      commoditySelect?.addEventListener("change", refreshVarietiesForDefaults);
      varietySelect?.addEventListener("change", refreshGradesForDefaults);
      gradeSelect?.addEventListener("change", () => {
        syncRowGradeSelects();
        syncTargets();
      });
      priceUnitSelect?.addEventListener("change", syncTargets);
      arrivalUnitSelect?.addEventListener("change", syncTargets);

      refreshCommoditiesForDefaults();
      syncRowGradeSelects();
      syncTargets();
    });
  };

  const setupResponsiveSidebar = () => {
    const sidebar = document.querySelector("[data-app-sidebar]");
    const overlay = document.querySelector("[data-sidebar-overlay]");
    const toggleButtons = document.querySelectorAll("[data-sidebar-toggle]");
    const closeButtons = document.querySelectorAll("[data-sidebar-close]");
    const navLinks = document.querySelectorAll(".sidebar .nav-link");

    if (!sidebar || !overlay || toggleButtons.length === 0) return;

    const setExpanded = (expanded) => {
      toggleButtons.forEach((button) => button.setAttribute("aria-expanded", expanded ? "true" : "false"));
    };

    const closeSidebar = () => {
      document.body.classList.remove("sidebar-open");
      setExpanded(false);
    };

    const openSidebar = () => {
      document.body.classList.add("sidebar-open");
      document.body.classList.remove("sidebar-collapsed");
      setExpanded(true);
    };

    const toggleSidebar = () => {
      if (window.innerWidth <= 980) {
        if (document.body.classList.contains("sidebar-open")) {
          closeSidebar();
        } else {
          openSidebar();
        }
        return;
      }

      document.body.classList.toggle("sidebar-collapsed");
      document.body.classList.remove("sidebar-open");
      setExpanded(!document.body.classList.contains("sidebar-collapsed"));
    };

    toggleButtons.forEach((button) => {
      if (button.dataset.sidebarBound === "true") return;

      button.dataset.sidebarBound = "true";
      button.addEventListener("click", toggleSidebar);
    });

    closeButtons.forEach((button) => {
      if (button.dataset.sidebarBound === "true") return;

      button.dataset.sidebarBound = "true";
      button.addEventListener("click", closeSidebar);
    });

    if (overlay.dataset.sidebarBound !== "true") {
      overlay.dataset.sidebarBound = "true";
      overlay.addEventListener("click", closeSidebar);
    }

    navLinks.forEach((link) => {
      if (link.dataset.sidebarBound === "true") return;

      link.dataset.sidebarBound = "true";
      link.addEventListener("click", () => {
        if (window.innerWidth <= 980) closeSidebar();
      });
    });

    if (window.innerWidth <= 980) {
      document.body.classList.remove("sidebar-collapsed");
      closeSidebar();
    } else {
      document.body.classList.remove("sidebar-open");
      setExpanded(!document.body.classList.contains("sidebar-collapsed"));
    }
  };

  const setupUnitConverters = () => {
    const normalizeUnit = (unit) => {
      const value = String(unit || "").toLowerCase();
      if (value.includes("kg") || value.includes("kilo")) return "kg";
      if (value.includes("mt") || value.includes("metric") || value.includes("ton")) return "mt";
      return "qtl";
    };

    const toKg = (value, unit) => {
      if (unit === "kg") return value;
      if (unit === "mt") return value * 1000;
      return value * 100;
    };

    const fromKg = (value, unit) => {
      if (unit === "kg") return value;
      if (unit === "mt") return value / 1000;
      return value / 100;
    };

    const priceToTarget = (value, sourceUnit, targetUnit) => {
      const source = normalizeUnit(sourceUnit);
      const perKg = source === "kg" ? value : source === "mt" ? value / 1000 : value / 100;
      if (targetUnit === "kg") return perKg;
      if (targetUnit === "mt") return perKg * 1000;
      return perKg * 100;
    };

    const formatter = new Intl.NumberFormat("en-IN", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

    document.querySelectorAll("[data-unit-table]").forEach((table) => {
      const render = (kind, targetUnit) => {
        table.querySelectorAll(`[data-unit-value][data-unit-kind="${kind}"]`).forEach((cell) => {
          const rawValue = Number.parseFloat(cell.dataset.sourceValue);
          if (!Number.isFinite(rawValue)) {
            cell.textContent = "-";
            return;
          }

          const sourceUnit = normalizeUnit(cell.dataset.sourceUnit);
          const nextValue = kind === "price" ? priceToTarget(rawValue, sourceUnit, targetUnit) : fromKg(toKg(rawValue, sourceUnit), targetUnit);
          cell.textContent = formatter.format(nextValue);
        });
      };

      table.querySelectorAll("[data-unit-control]").forEach((select) => {
        if (select.dataset.unitBound === "true") return;

        select.dataset.unitBound = "true";
        select.addEventListener("change", () => render(select.dataset.unitControl, select.value));
        render(select.dataset.unitControl, select.value);
      });
    });
  };

  const clearLiveClockTimers = () => {
    window.mandiClockTimers = window.mandiClockTimers || [];
    window.mandiClockTimers.forEach((timer) => window.clearInterval(timer));
    window.mandiClockTimers = [];
    document.body.classList.remove("sidebar-open");
  };

  const setupLiveClock = () => {
    clearLiveClockTimers();

    document.querySelectorAll("[data-live-clock]").forEach((root) => {
      const timeZone = root.dataset.timezone || "Asia/Kolkata";
      const timeNode = root.querySelector("[data-clock-time]");
      const dateNode = root.querySelector("[data-clock-date]");
      const contextNode = root.querySelector("[data-clock-context]");
      const hourHand = root.querySelector("[data-clock-hour]");
      const minuteHand = root.querySelector("[data-clock-minute]");
      const secondHand = root.querySelector("[data-clock-second]");

      const timeFormatter = new Intl.DateTimeFormat("en-IN", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: true,
        timeZone
      });

      const dateFormatter = new Intl.DateTimeFormat("en-IN", {
        weekday: "long",
        day: "2-digit",
        month: "short",
        year: "numeric",
        timeZone
      });

      const partsFormatter = new Intl.DateTimeFormat("en-US", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        hourCycle: "h23",
        timeZone
      });

      const updateClock = () => {
        const now = new Date();
        const parts = Object.fromEntries(
          partsFormatter
            .formatToParts(now)
            .filter((part) => part.type !== "literal")
            .map((part) => [part.type, part.value])
        );

        const hours = Number(parts.hour || 0);
        const minutes = Number(parts.minute || 0);
        const seconds = Number(parts.second || 0);

        const hourAngle = ((hours % 12) + minutes / 60) * 30;
        const minuteAngle = (minutes + seconds / 60) * 6;
        const secondAngle = seconds * 6;

        if (timeNode) timeNode.textContent = timeFormatter.format(now);
        if (dateNode) dateNode.textContent = dateFormatter.format(now);

        if (contextNode) {
          contextNode.textContent =
            hours < 12 ? "Fresh morning arrivals window" :
            hours < 17 ? "Active mandi reporting hours" :
            "Evening review and closing update";
        }

        if (hourHand) hourHand.style.transform = `translateX(-50%) rotate(${hourAngle}deg)`;
        if (minuteHand) minuteHand.style.transform = `translateX(-50%) rotate(${minuteAngle}deg)`;
        if (secondHand) secondHand.style.transform = `translateX(-50%) rotate(${secondAngle}deg)`;
      };

      updateClock();
      window.mandiClockTimers.push(window.setInterval(updateClock, 1000));
    });
  };

  // Date filters render as text so the box reads "From date" while empty, and
  // become native date pickers the moment the user interacts with them.
  const setupPlaceholderDateInputs = () => {
    document.querySelectorAll("input[data-date-input]").forEach((input) => {
      if (input.dataset.dateInputReady === "true") return;
      input.dataset.dateInputReady = "true";

      const asDate = () => {
        if (input.type !== "date") input.type = "date";
      };

      const asText = () => {
        if (!input.value) input.type = "text";
      };

      if (input.value) asDate();

      input.addEventListener("focus", asDate);
      input.addEventListener("pointerdown", asDate);
      input.addEventListener("blur", asText);
    });
  };

  // Filters the rows of every section on a cotton report in place. The whole
  // sheet is already rendered, so typing never needs a round trip.
  const setupSheetSearch = () => {
    const input = document.querySelector("[data-sheet-search]");
    if (!input) return;

    const status = document.querySelector("[data-sheet-search-status]");
    const sections = Array.from(document.querySelectorAll("[data-sheet-section]"));
    if (sections.length === 0) return;

    const applyFilter = () => {
      const term = input.value.trim().toLowerCase();
      let shownRows = 0;
      let shownSections = 0;

      sections.forEach((section) => {
        const rows = Array.from(section.querySelectorAll("tbody tr"));
        const heading = section.querySelector(".sheet-header");
        // Searching a section name ("candy rate") keeps that whole section,
        // so the name in the heading counts as a match for every row in it.
        const headingHit = term !== "" && heading !== null &&
          heading.textContent.toLowerCase().includes(term);
        let visibleRows = 0;

        rows.forEach((row) => {
          const matched = term === "" || headingHit || row.textContent.toLowerCase().includes(term);
          row.hidden = !matched;
          if (matched) visibleRows += 1;
        });

        // A section with no table of its own (the comparison launcher) can only
        // match on its heading.
        const keep = rows.length > 0 ? term === "" || visibleRows > 0 : term === "" || headingHit;

        section.hidden = !keep;
        if (keep) shownSections += 1;
        shownRows += visibleRows;
      });

      if (!status) return;

      if (term === "") {
        status.textContent = "";
      } else if (shownSections === 0) {
        status.textContent = "No rows match \u201C" + input.value.trim() + "\u201D";
      } else {
        status.textContent = shownRows + (shownRows === 1 ? " row" : " rows") + " in " +
          shownSections + (shownSections === 1 ? " section" : " sections");
      }
    };

    input.addEventListener("input", applyFilter);
    input.addEventListener("search", applyFilter);
    applyFilter();
  };

  const bootMandiUi = () => {
    setupPlaceholderDateInputs();
    setupSheetSearch();
    setupMarketForm();
    setupGradeForm();
    setupReportForm();
    setupDeleteConfirm();
    setupObservationGrid();
    setupDailyEntryDateSync();
    setupDailyEntryDefaults();
    setupResponsiveSidebar();
    setupUnitConverters();
    setupLiveClock();
  };

  document.addEventListener("DOMContentLoaded", bootMandiUi);
  document.addEventListener("turbo:load", bootMandiUi);
  document.addEventListener("turbo:before-cache", clearLiveClockTimers);
</script>
